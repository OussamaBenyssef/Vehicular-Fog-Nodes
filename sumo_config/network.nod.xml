<?xml version="1.0" encoding="UTF-8"?>
<!-- Noeuds du réseau urbain pour simulation fog -->
<nodes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
       xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/nodes_file.xsd">
    
    <!-- Points d'entrée/sortie du réseau -->
    <node id="N1" x="0.00" y="300.00" type="priority"/>
    <node id="N2" x="600.00" y="300.00" type="priority"/>
    <node id="S1" x="200.00" y="0.00" type="priority"/>
    <node id="S2" x="400.00" y="0.00" type="priority"/>
    <node id="N3" x="200.00" y="600.00" type="priority"/>
    <node id="N4" x="400.00" y="600.00" type="priority"/>
    
    <!-- Intersections avec feux de circulation (positions RSU) -->
    <node id="J1" x="200.00" y="200.00" type="traffic_light"/>
    <node id="J2" x="400.00" y="200.00" type="traffic_light"/>
    <node id="J3" x="200.00" y="400.00" type="traffic_light"/>
    <node id="J4" x="400.00" y="400.00" type="traffic_light"/>
</nodes>
