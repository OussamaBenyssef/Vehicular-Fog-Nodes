<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration SUMO - SCÉNARIO: PEU de véhicules Fog-capable (~15%) -->
<!-- DÉBIT TOTAL: ~2000 véh/h pour simuler la congestion -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Types de véhicules -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="4.5" 
           minGap="2.5" maxSpeed="50" guiShape="passenger" color="0,0,255"/>
    <vType id="fog_capable" accel="2.8" decel="4.5" sigma="0.4" length="4.8" 
           minGap="2.5" maxSpeed="55" guiShape="passenger/sedan" color="0,255,0"/>
    <vType id="bus" accel="1.2" decel="4.0" sigma="0.5" length="12" 
           minGap="3" maxSpeed="30" guiShape="bus" color="255,165,0"/>
    <vType id="truck" accel="1.0" decel="4.0" sigma="0.5" length="10" 
           minGap="3" maxSpeed="25" guiShape="truck" color="128,0,128"/>

    <!-- Routes -->
    <route id="route_we_1" edges="E_N1_J1 E_J1_J2 E_J2_N2"/>
    <route id="route_ew_1" edges="E_N2_J2 E_J2_J1 E_J1_N1"/>
    <route id="route_we_alt" edges="E_N1_J3 E_J3_J4 E_J4_N2"/>
    <route id="route_sn_1" edges="E_S1_J1 E_J1_J3 E_J3_N3"/>
    <route id="route_sn_2" edges="E_S2_J2 E_J2_J4 E_J4_N4"/>
    <route id="route_ns_1" edges="E_N3_J3 E_J3_J1 E_J1_S1"/>
    <route id="route_ns_2" edges="E_N4_J4 E_J4_J2 E_J2_S2"/>
    <route id="route_cross_1" edges="E_N1_J1 E_J1_J3 E_J3_J4 E_J4_N4"/>
    <route id="route_cross_2" edges="E_S1_J1 E_J1_J2 E_J2_J4 E_J4_N4"/>

    <!-- ============================================================ -->
    <!-- SCÉNARIO: PEU DE FOG NODES (~15% fog-capable) -->
    <!-- DÉBIT TOTAL: ~2000 véh/h -->
    <!-- Répartition: 85% standard, 15% fog-capable -->
    <!-- ============================================================ -->
    
    <!-- Véhicules standards (85% = ~1700 véh/h) -->
    <flow id="low_we_car" type="car" route="route_we_1" 
          begin="0" end="300" vehsPerHour="440" departLane="best"/>
    <flow id="low_ew_car" type="car" route="route_ew_1" 
          begin="0" end="300" vehsPerHour="400" departLane="best"/>
    <flow id="low_sn_car" type="car" route="route_sn_1" 
          begin="0" end="300" vehsPerHour="360" departLane="best"/>
    <flow id="low_ns_car" type="car" route="route_ns_1" 
          begin="0" end="300" vehsPerHour="320" departLane="best"/>
    <flow id="low_cross_car" type="car" route="route_cross_2" 
          begin="0" end="300" vehsPerHour="180" departLane="best"/>
    <!-- Sous-total car: 1700 véh/h -->
    
    <!-- PEU de véhicules fog-capable (15% = ~300 véh/h) -->
    <flow id="low_we_fog" type="fog_capable" route="route_we_1" 
          begin="0" end="300" vehsPerHour="100" departLane="best"/>
    <flow id="low_ew_fog" type="fog_capable" route="route_ew_1" 
          begin="0" end="300" vehsPerHour="80" departLane="best"/>
    <flow id="low_sn_fog" type="fog_capable" route="route_sn_2" 
          begin="0" end="300" vehsPerHour="70" departLane="best"/>
    <flow id="low_ns_fog" type="fog_capable" route="route_ns_2" 
          begin="0" end="300" vehsPerHour="50" departLane="best"/>
    <!-- Sous-total fog: 300 véh/h -->
    
    <!-- Camions et bus -->
    <flow id="low_truck" type="truck" route="route_we_1" 
          begin="0" end="300" period="60" departLane="best"/>
    <flow id="low_bus" type="bus" route="route_cross_1" 
          begin="0" end="300" period="90" departLane="best"/>

    <!-- TOTAL: ~2000 véh/h -->

</routes>
