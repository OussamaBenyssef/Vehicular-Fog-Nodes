<?xml version="1.0" encoding="UTF-8"?>
<!-- Arêtes (routes) du réseau urbain -->
<edges xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
       xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/edges_file.xsd">
    
    <!-- Routes horizontales principales (100 km/h) -->
    <edge id="E_N1_J1" from="N1" to="J1" priority="12" numLanes="2" speed="27.78"/>
    <edge id="E_J1_N1" from="J1" to="N1" priority="12" numLanes="2" speed="27.78"/>
    <edge id="E_J1_J2" from="J1" to="J2" priority="12" numLanes="2" speed="27.78"/>
    <edge id="E_J2_J1" from="J2" to="J1" priority="12" numLanes="2" speed="27.78"/>
    <edge id="E_J2_N2" from="J2" to="N2" priority="12" numLanes="2" speed="27.78"/>
    <edge id="E_N2_J2" from="N2" to="J2" priority="12" numLanes="2" speed="27.78"/>
    
    <edge id="E_J3_J4" from="J3" to="J4" priority="12" numLanes="2" speed="27.78"/>
    <edge id="E_J4_J3" from="J4" to="J3" priority="12" numLanes="2" speed="27.78"/>
    
    <!-- Routes verticales secondaires (80 km/h) -->
    <edge id="E_S1_J1" from="S1" to="J1" priority="9" numLanes="2" speed="22.22"/>
    <edge id="E_J1_S1" from="J1" to="S1" priority="9" numLanes="2" speed="22.22"/>
    <edge id="E_J1_J3" from="J1" to="J3" priority="9" numLanes="2" speed="22.22"/>
    <edge id="E_J3_J1" from="J3" to="J1" priority="9" numLanes="2" speed="22.22"/>
    <edge id="E_J3_N3" from="J3" to="N3" priority="9" numLanes="2" speed="22.22"/>
    <edge id="E_N3_J3" from="N3" to="J3" priority="9" numLanes="2" speed="22.22"/>
    
    <edge id="E_S2_J2" from="S2" to="J2" priority="9" numLanes="2" speed="22.22"/>
    <edge id="E_J2_S2" from="J2" to="S2" priority="9" numLanes="2" speed="22.22"/>
    <edge id="E_J2_J4" from="J2" to="J4" priority="9" numLanes="2" speed="22.22"/>
    <edge id="E_J4_J2" from="J4" to="J2" priority="9" numLanes="2" speed="22.22"/>
    <edge id="E_J4_N4" from="J4" to="N4" priority="9" numLanes="2" speed="22.22"/>
    <edge id="E_N4_J4" from="N4" to="J4" priority="9" numLanes="2" speed="22.22"/>
    
    <!-- Connexions diagonales entre J1-J4 et J2-J3 pour plus de routes -->
    <edge id="E_N1_J3" from="N1" to="J3" priority="6" numLanes="1" speed="16.67"/>
    <edge id="E_J3_N1" from="J3" to="N1" priority="6" numLanes="1" speed="16.67"/>
    <edge id="E_N2_J4" from="N2" to="J4" priority="6" numLanes="1" speed="16.67"/>
    <edge id="E_J4_N2" from="J4" to="N2" priority="6" numLanes="1" speed="16.67"/>
</edges>
