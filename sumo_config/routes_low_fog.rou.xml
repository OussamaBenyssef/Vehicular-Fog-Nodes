<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuration SUMO - SCÉNARIO: LOW FOG (~10% fog-capable) -->
<!-- DÉBIT TOTAL: 2000 véh/h - 10% fog-capable, 90% standard -->
<!-- SYNCHRONISÉ avec les autres scénarios pour comparaison équitable -->
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- Types de véhicules -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="4.5" 
           minGap="2.5" maxSpeed="50" guiShape="passenger" color="0,0,255"/>
    <vType id="fog_capable" accel="2.8" decel="4.5" sigma="0.4" length="4.8" 
           minGap="2.5" maxSpeed="55" guiShape="passenger/sedan" color="0,255,0"/>
    <vType id="bus" accel="1.2" decel="4.0" sigma="0.5" length="12" 
           minGap="3" maxSpeed="30" guiShape="bus" color="255,165,0"/>
    <vType id="truck" accel="1.0" decel="4.0" sigma="0.5" length="10" 
           minGap="3" maxSpeed="25" guiShape="truck" color="128,0,128"/>

    <!-- Routes (IDENTIQUES pour tous les scénarios) -->
    <route id="route_we" edges="E_N1_J1 E_J1_J2 E_J2_N2"/>
    <route id="route_ew" edges="E_N2_J2 E_J2_J1 E_J1_N1"/>
    <route id="route_sn" edges="E_S1_J1 E_J1_J3 E_J3_N3"/>
    <route id="route_ns" edges="E_N3_J3 E_J3_J1 E_J1_S1"/>
    <route id="route_cross" edges="E_S1_J1 E_J1_J2 E_J2_J4 E_J4_N4"/>

    <!-- ============================================================ -->
    <!-- SCÉNARIO: LOW FOG (10% fog-capable, 90% standard) -->
    <!-- DÉBIT TOTAL: 2000 véh/h - TIMING SYNCHRONISÉ -->
    <!-- ============================================================ -->
    
    <!-- Route WE: 500 véh/h (90% car = 450, 10% fog = 50) -->
    <flow id="we_car" type="car" route="route_we" 
          begin="0" end="300" vehsPerHour="450" departLane="best" departSpeed="max"/>
    <flow id="we_fog" type="fog_capable" route="route_we" 
          begin="0" end="300" vehsPerHour="50" departLane="best" departSpeed="max"/>
    
    <!-- Route EW: 450 véh/h (90% car = 405, 10% fog = 45) -->
    <flow id="ew_car" type="car" route="route_ew" 
          begin="0" end="300" vehsPerHour="405" departLane="best" departSpeed="max"/>
    <flow id="ew_fog" type="fog_capable" route="route_ew" 
          begin="0" end="300" vehsPerHour="45" departLane="best" departSpeed="max"/>
    
    <!-- Route SN: 400 véh/h (90% car = 360, 10% fog = 40) -->
    <flow id="sn_car" type="car" route="route_sn" 
          begin="0" end="300" vehsPerHour="360" departLane="best" departSpeed="max"/>
    <flow id="sn_fog" type="fog_capable" route="route_sn" 
          begin="0" end="300" vehsPerHour="40" departLane="best" departSpeed="max"/>
    
    <!-- Route NS: 350 véh/h (90% car = 315, 10% fog = 35) -->
    <flow id="ns_car" type="car" route="route_ns" 
          begin="0" end="300" vehsPerHour="315" departLane="best" departSpeed="max"/>
    <flow id="ns_fog" type="fog_capable" route="route_ns" 
          begin="0" end="300" vehsPerHour="35" departLane="best" departSpeed="max"/>
    
    <!-- Route Cross: 300 véh/h (90% car = 270, 10% fog = 30) -->
    <flow id="cross_car" type="car" route="route_cross" 
          begin="0" end="300" vehsPerHour="270" departLane="best" departSpeed="max"/>
    <flow id="cross_fog" type="fog_capable" route="route_cross" 
          begin="0" end="300" vehsPerHour="30" departLane="best" departSpeed="max"/>

    <!-- TOTAL: 2000 véh/h (~10% fog-capable = 200 véh/h) -->

</routes>
